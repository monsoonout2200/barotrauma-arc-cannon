<Items>
  <!-- ============================================================
       电弧炮 Arc Cannon
       大型炮塔 / 蓄力 1.5 秒 / 发射一道电弧
       普通电弧弹药：250 烧伤 + 100 深层组织伤（单发）
       自制贴图（都放在 mod 根目录）：
         turrets_base.png   = 底座
         turrets_gun.png    = 机身 + 两根炮管（旋转主体，轴承圆盘已经合成在这张图里）
         turrets_loader.png = 装弹器
         turrets_yoke.png   = 轴承圆盘原件（已合成进 turrets_gun.png，仅留档）
         ammoboxarc.png     = 弹药箱
       装弹器暂时仍用原版 Loaders.png 贴图 + 冷色染色，等美术切图后再换。
       ============================================================ -->
  <Item name="电弧炮" description="一台架在大型硬点上的重型电弧炮塔，靠电容组把整段能量压成一道电弧发射出去。蓄力完成后才能放电，命中的血肉会被烧穿，并连带电击目标、留下深层组织损伤；代价是射速慢、耗电高，而且对船壳和舱门几乎无能为力。" identifier="arccannon" Tags="turret,slowturret" category="Machine,Weapon" subcategory="subweapons" interactthroughwalls="true" Scale="0.5" interactdistance="10" focusonselected="true" offsetonselected="800" linkable="true" allowedlinks="arccannonequipment">
    <!-- MOD_ART：自制底座（不随潜望镜转动的那部分）。
         图 = 1793683716196.png（mod 根目录）。
         如果以后把图紧裁（去掉透明边），sourcerect 要同步改成 0,0,宽,高，
         并且 Turret 的 barrelpos 与 SwappableItem 的 origin 都要减去裁剪偏移。 -->
    <Sprite texture="%ModDir%/img/turrets_base.png" depth="0.01" sourcerect="35,73,426,370" origin="0.5,0.5" canflipy="false" />
    <!-- 轴承圆盘（镶在底座大环孔里那块）。
         DecorativeSprite 这条路走不通：它压不过炮身（炮身 0.011 始终盖在上面），
         圆盘会被炮身底部的安装座挡住，看起来就像"没生效"。
         改成直接把圆盘合成进 turrets_gun.png 的转轴位置（图内坐标 636,618），
         这样它跟着炮身一起转，而且天然在底座之上。原件留档为 turrets_gun_art_only.png。 -->
    <MinimapIcon name="Command_Weapons_ArcCannon" texture="Content/UI/CommandUIAtlas.png" sourcerect="384,768,128,128" />
    <SwappableItem price="7500" replacementonuninstall="largeturrethardpoint" origin="213,370" swapidentifier="largeturret">
      <SchematicSprite texture="Content/UI/WeaponUI.png" sourcerect="768,0,256,389" />
      <SwapConnectedItem tag="periscope" swapto="periscope" />
      <SwapConnectedItem tag="turretammosource" swapto="arccannonloader" />
    </SwappableItem>
    <UpgradePreviewSprite scale="2.5" texture="Content/UI/WeaponUI.png" sourcerect="265,810,96,65" origin="0.5,0.5" />
    <StaticBody width="80" radius="80" />
    <Turret singlechargedshot="true" maxchargetime="1.5" reload="1.5" canbeselected="false" characterusable="false" linkable="true" barrelpos="218,103" firingoffset="0,-522" usefiringoffsetformuzzleflash="true" rotationlimits="180,360" powerconsumption="5000.0" showchargeindicator="true" showprojectileindicator="true" recoildistance="60" springstiffnesslowskill="2" springstiffnesshighskill="50" springdampinglowskill="0.5" springdampinghighskill="10" rotationspeedlowskill="1" rotationspeedhighskill="7" MaxAngleOffset="15" AICurrentTargetPriorityMultiplier="1" ChargeSoundWindupPitchSlide="0.4,1.0">
      <!-- 开炮音效：自制音频（mod 根目录）。已裁到 1.4 秒并加淡出：
           原来 1.97 秒会拖到下一发（蓄力 1.5 + 装填 0.5 ≈ 2 秒一发），同一声音实例还在播时，
           引擎会丢掉新的那次播放 —— 这就是"有时候开火没声音"的主因。
           同时去掉了叠在底下的原版放电声，减少同帧并发音频的数量。 -->
      <sound file="%ModDir%/arccannon_fire.ogg" range="12000" type="OnUse" volume="1.4" />
      <WeaponIndicator texture="Content/UI/WeaponUI.png" sourcerect="500,913,66,32" origin="0.227, 0.5" />
      <!-- MOD_ART：旋转主体（新炮身 + 合成进来的轴承圆盘）。
           新炮身实测边界 469,82 333x581；圆盘合成在 (636,620)、半径 75，底边到 695，
           所以矩形高度取到 613（82+613=695），origin y = 538/613 = 0.878，仍把圆盘中心钉在炮位(barrelpos)上。 -->
      <RailSprite texture="%ModDir%/img/turrets_gun.png" depth="0.011" sourcerect="469,82,333,613" origin="0.502,0.878" />
      <!-- 炮管已包含在上面那张图里，不再单独挂 BarrelSprite（否则会叠出一根原版导轨炮的炮管） -->
      <Crosshair texture="Content/Items/Weapons/Crosshairs.png" sourcerect="256,0,256,256" />
      <CrosshairPointer texture="Content/Items/Weapons/Crosshairs.png" sourcerect="0,0,256,256" />
      <MoveSound file="Content/Items/Weapons/RailgunLoop.ogg" />
      <StartMoveSound file="Content/Items/Weapons/RailgunStart.ogg" />
      <EndMoveSound file="Content/Items/Weapons/RailgunStop.ogg" />
      <ChargeSound file="Content/Items/Weapons/WEAPONS_chargeUp.ogg" range="10000" />
      <!-- ==== 蓄力特效：只保留炮口电球 ====
           ChargeSprite 钉在物品坐标系，炮塔一转就错位；ParticleEmitterCharge 的 distance 也是
           在未旋转的坐标系里偏移（实测电柱不贴炮管），所以两个都去掉，只留炮口那一团。
           炮口位置本身是随炮塔旋转的，所以电球永远在炮管顶端。 -->
      <ParticleEmitterCharge particle="arccannon_charge" particlespersecond="40" scalemin="1.0" scalemax="1.6" anglemax="360" />
      <ParticleEmitterCharge particle="arccannon_charge" particlespersecond="15" scalemin="1.8" scalemax="2.4" anglemax="360" />
      <RequiredSkill identifier="weapons" level="60" />
      <LightComponent LightColor="0.65,0.85,1.0,1.0" Flicker="0.0" range="2500" directional="true" IsOn="true" drawbehindsubs="true" ignorecontinuoustoggle="true" InheritParentIsActive="false">
        <LightTexture texture="Content/Lights/lightcone.png" origin="0.0, 0.5" size="1.0,1.0" />
      </LightComponent>
      <!-- 炮口：开火瞬间的爆散（蓄力表现已改由上面的 ParticleEmitterCharge 负责） -->
      <ParticleEmitter particle="arccannon_impact" particleamount="3" anglemin="0" anglemax="360" velocitymin="0" velocitymax="100" scalemin="0.5" scalemax="0.8" />
      <ParticleEmitter particle="FlareBubbles" particleamount="7" anglemin="0" anglemax="360" velocitymin="0" velocitymax="50" colormultiplier="170,215,255,200" />
      <!-- 开火时的屏幕反馈：只有镜头抖动与闪光，不做伤害 -->
      <StatusEffect type="OnUse" target="This">
        <Explosion range="1200.0" structuredamage="0" itemdamage="0" force="0.0" camerashake="12.0" flames="false" smoke="false" sparks="false" underwaterbubble="false" flash="true" flashcolor="150,205,255,255" flashrange="1600" flashduration="0.15" />
      </StatusEffect>
    </Turret>
    <aitarget maxsightrange="3000" maxsoundrange="8000" fadeouttime="5" />
    <ConnectionPanel selectkey="Action" canbeselected="true" msg="ItemMsgRewireScrewdriver" hudpriority="10">
      <GuiFrame relativesize="0.2,0.32" minsize="400,350" maxsize="480,420" anchor="Center" style="ConnectionPanel" />
      <RequiredItem items="screwdriver" type="Equipped" />
      <input name="power_in" displayname="connection.powerin" />
      <input name="position_in" displayname="connection.turretaimingin" />
      <input name="trigger_in" displayname="connection.turrettriggerin" />
      <input name="toggle_light" displayname="connection.togglelight" />
      <input name="set_light" displayname="connection.setlight" />
      <input name="set_auto_operate" displayname="connection.setautooperate" />
      <input name="toggle_auto_operate" displayname="connection.toggleautooperate" />
    </ConnectionPanel>
    <SkillRequirementHint identifier="weapons" level="60" />
  </Item>
