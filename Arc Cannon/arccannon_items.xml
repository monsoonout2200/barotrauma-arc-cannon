    </Projectile>
    <!-- 吸力：照原版重力弹的写法（railgun.xml:611），force 为正 = 朝中心拉。
         半径比帷幕的 180 略大（220），这样边缘外的目标也会被拽进来。
         distancebasedforce="false" = 远近力度一样，不会越靠近越猛。
         想更猛就把 force 提到 200~300；想只吸生物不吸物品，删掉 triggeredby 里的 Item。 -->
    <TriggerComponent triggeredby="Creature,Human,Item" force="80" radius="220" distancebasedforce="false" />
  </Item>
  <!-- ============================ 电弧帷幕弹丸（紫色） ============================ -->
  <Item name="电弧帷幕单元" identifier="arccannonbolt2" category="Weapon" scale="0.5" sonarsize="2" hideinmenus="true">
    <Sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="0,0,1,1" depth="0.55" color="0,0,0,0" />
    <Body width="170" height="10" density="20" />
    <Holdable slots="RightHand+LeftHand" holdpos="0,-50" handle1="-10,0" handle2="10,0" aimable="false" />
    <Projectile characterusable="false" hitscan="true" removeonhit="true" penetration="1.0" damagedoors="true" maxtargetstohit="1">
      <!-- 紫色脉冲：从炮口沿瞄准方向窜出去的一发紫光（不是铺射线的珠子）。
           hit-scan 瞬时命中，引擎没有"从炮口飞到目标"的脉冲机制，
           所以它只飞出去一段就淡掉；想要真正飞到目标只能上 Lua 脚本。
           distance 245~270 = firingoffset 522 × 物品 Scale 0.5 ≈ 261 世界像素，
           把发射点从炮塔中心推到炮口（这一段待实测：若偏到固定方向，说明 distance 不随炮塔旋转）。 -->
      <ParticleEmitter particle="arccannon_pulse_purple" particleamount="2" copyentityangle="true" anglemin="-3" anglemax="3" velocitymin="1000" velocitymax="1400" scalemin="0.8" scalemax="1.2" distancemin="245" distancemax="270" />
      <!-- 直击：小伤害，主要作用是布场 -->
      <Attack structuredamage="0" itemdamage="0" severlimbsprobability="0" penetration="1.0">
        <Affliction identifier="electricshock" strength="20" />
        <Affliction identifier="slow" strength="20" />
      </Attack>
      <!-- 命中后就地拉起电弧帷幕（爆散粒子由帷幕自己的 OnSpawn 负责，这里不重复生成）
           同时放一个和帷幕同半径（180）的冲击爆炸：画面和电弧场一致，但只造眩晕、不带任何伤害。
           stun 10 = 约 10 秒硬控（对 StunImmunity 的 21 个角色无效，这是原版布尔免疫）。 -->
      <StatusEffect type="OnImpact" target="This">
        <SpawnItem identifier="arccannon_arcmist" spawnposition="This" />
        <Explosion range="180.0" structuredamage="0" itemdamage="0" ballastfloradamage="0"
                   force="0.0" flames="false" smoke="false" sparks="true" underwaterbubble="false"
                   applyfireeffects="false" camerashake="3.0"
                   flash="true" flashcolor="190,130,255,255" flashrange="900" flashduration="0.1"
                   ignorecover="true">
          <Affliction identifier="stun" strength="10" />
        </Explosion>
      </StatusEffect>
      <StatusEffect type="OnNotContained" target="This" delay="1">
        <Remove />
      </StatusEffect>
    </Projectile>
  </Item>
