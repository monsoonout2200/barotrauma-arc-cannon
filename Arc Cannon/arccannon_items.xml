  <!-- ============================ 电弧帷幕（第三种弹药的效果载体） ============================
       紫色电雾：命中后就地生成，存活 6 秒、半径 180，每 0.5 秒结算一次。
         · 对角色：电击 10 / 深层 3 / 烧伤 2
         · 对设备：EMP 10 / 耐久 -20（沿用红弹的电气机械白名单）
       注意：interval 与 nearbyCharacters 两个写法还没在游戏里验证过，见文件末尾说明。 -->
  <Item name="电弧帷幕" identifier="arccannon_arcmist" category="Misc" scale="0.5" hideinmenus="true">
    <Sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="0,0,1,1" color="0,0,0,0" depth="0.9" />
    <Body radius="10" density="1" gravityscale="0" />
    <Projectile characterusable="false" launchimpulse="0">
      <!-- 生成瞬间：一团紫色电弧炸开 -->
      <StatusEffect type="OnSpawn" target="This">
        <ParticleEmitter particle="arccannon_arcfog" particleamount="26" anglemin="0" anglemax="360" velocitymin="0" velocitymax="200" scalemin="1.2" scalemax="2.6" />
        <ParticleEmitter particle="ElectricShock" particleamount="6" anglemin="0" anglemax="360" velocitymin="0" velocitymax="150" scalemin="1.0" scalemax="2.0" />
        <sound file="Content/Items/Weapons/WEAPONS_electricalDischarge2.ogg" range="6000" selectionmode="Random" />
      </StatusEffect>
      <!-- 6 秒持续电弧雾：三层，全部是电弧本体，没有"雾团"贴图
           主雾 26 颗/秒（小、原地噼啪，靠数量闪成一片）
           大弧 5 颗/秒（偶发的长电弧，给层次）
           白电光 3 颗/秒（原版 ElectricShock，点出放电的高光） -->
      <StatusEffect type="OnSpawn" target="This" duration="6">
        <ParticleEmitter particle="arccannon_arcfog" particlespersecond="26" anglemin="0" anglemax="360" velocitymin="0" velocitymax="70" scalemin="0.7" scalemax="1.6" distancemin="0" distancemax="180" />
        <ParticleEmitter particle="arccannon_arcfog" particlespersecond="5" anglemin="0" anglemax="360" velocitymin="0" velocitymax="120" scalemin="1.8" scalemax="3.2" distancemin="0" distancemax="180" />
        <ParticleEmitter particle="ElectricShock" particlespersecond="3" anglemin="0" anglemax="360" velocitymin="0" velocitymax="60" scalemin="1.0" scalemax="2.0" distancemin="0" distancemax="180" />
      </StatusEffect>
      <!-- 每 0.5 秒：电人 -->
      <StatusEffect type="OnActive" target="nearbyCharacters" range="180" interval="0.5" duration="6">
        <Affliction identifier="electricshock" strength="10" />
        <Affliction identifier="internaldamage" strength="10" dividebylimbcount="false" />
        <Affliction identifier="burn" strength="15" dividebylimbcount="false" />
      </StatusEffect>
      <!-- 每 0.5 秒：电设备（EMP + 耐久 -20） -->
