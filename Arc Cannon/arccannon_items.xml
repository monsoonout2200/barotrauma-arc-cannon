  <!-- ============================ 过载电弧弹（第三种弹药） ============================
       一发、红色特效、命中后由"过载爆心"结算 2500 半径的设备破坏型战斗部：
         · 直射（电弧段）：800 总伤害（四种无抗性类型各 200）
         · 命中墙体/潜艇：2500 半径 itemdamage 600 —— 反应堆 explosiondamagemultiplier 0.2，
           600×0.2=120 > 100 耐久，所以只要反应堆里有燃料就会被打到熔毁。 -->
  <Item name="电弧放电单元·过载" identifier="arccannonbolt3" category="Weapon" scale="0.5" sonarsize="2" hideinmenus="true">
    <Sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="0,0,1,1" depth="0.55" color="0,0,0,0" />
    <Body width="170" height="10" density="20" />
    <Holdable slots="RightHand+LeftHand" holdpos="0,-50" handle1="-10,0" handle2="10,0" aimable="false" />
    <Projectile characterusable="false" hitscan="true" removeonhit="true" penetration="1.0" damagedoors="true" maxtargetstohit="1">
      <!-- 粒子光矛：沿射线每 22 像素叠一颗径向光球，密到互相重叠就成了一条连续光束。
           和蓝色电弧用同一套发射器写法（不带 copyentityangle，那是指向偏移的根源）。 -->
      <ParticleEmitter particle="arccannon_lance_red" particleamount="1" emitacrossrayinterval="22" scalemin="1" scalemax="1.15" />
      <!-- 光束边缘再撒一点电弧碎片，避免看起来太"硬" -->
      <ParticleEmitter particle="arccannon_arc_red" particleamount="1" emitacrossrayinterval="90" scalemin="0.35" scalemax="0.6" />
      <!-- 直击：只挂减速 80。麻痹改到下面独立的 StatusEffect 里施加。 -->
      <Attack structuredamage="0" itemdamage="0" severlimbsprobability="0" penetration="1.0">
        <Affliction identifier="slow" strength="80" />
      </Attack>
      <!-- 直击结算（全身）：这一段不写 targetlimbs，配合 dividebylimbcount="false"
           会把每个症状**施加到目标的每一个部位**上，而不是只挂在被打中的那一块。
             · internaldamage 75 / burn 45 → 每部位各一份
             · arccannon_paralysis 30        → 每个部位各 30 点，每秒 -1，30 秒归零
           因为过载麻痹是 limbspecific="true"，能被部位承载；而引擎判 IsParalyzed 只看
           "角色身上有没有 type=paralysis 的症状"，全身都有 → 必然成立。 -->
      <StatusEffect type="OnImpact" target="UseTarget">
        <Conditional entitytype="eq Character" />
        <Affliction identifier="internaldamage" strength="75" dividebylimbcount="false" />
        <Affliction identifier="burn" strength="45" dividebylimbcount="false" />
        <Affliction identifier="arccannon_paralysis" strength="120" dividebylimbcount="false" />
      </StatusEffect>
      <!-- 方案 A：照原版 EMP 手雷那条写（<StatusEffect type="OnBroken" target="nearbyItems" range="450"
             targettags="loadable" condition="-100" />）—— 不经过爆炸结算，按半径直接改物品耐久。
           第一段按 tag 白名单命中"电气与机械"（含船用电池 battery / batterycellrecharger）；
           耗材（氧气罐/焊枪/燃料棒/材料）原版没有 tag，天然被排除。
           带 Conditional entitytype="neq Character"：直击打中生物时不做范围结算。 -->
      <StatusEffect type="OnImpact" target="nearbyItems" range="2500" targettags="pump,reactor,junctionbox,engine,supercapacitor,command,statusmonitor,battery,batterycellrecharger" condition="-600">
        <Conditional entitytype="neq Character" />
      </StatusEffect>
      <!-- 第二段按 identifier 补漏：原版这几个设备没有 tags，只能用 id 精确点名
           （targetidentifiers 的原版用法见 traitor_items.xml:302）。 -->
      <StatusEffect type="OnImpact" target="nearbyItems" range="2500" targetidentifiers="oxygenerator,fabricator,deconstructor,medicalfabricator" condition="-600">
        <Conditional entitytype="neq Character" />
      </StatusEffect>
      <!-- 命中点的红色电光（纯视觉）：扩散控制在约 120 像素内 -->
      <StatusEffect type="OnImpact" target="This">
        <ParticleEmitter particle="arccannon_impact_red" particleamount="12" anglemin="0" anglemax="360" velocitymin="0" velocitymax="120" scalemin="0.8" scalemax="1.5" />
        <ParticleEmitter particle="ElectricShock" particleamount="6" anglemin="0" anglemax="360" scalemin="1.5" scalemax="3" velocitymin="0" velocitymax="100" />
        <sound file="Content/Items/Weapons/WEAPONS_electricalDischarge1.ogg" range="20000" selectionmode="Random" />
      </StatusEffect>
    </Projectile>
  </Item>
