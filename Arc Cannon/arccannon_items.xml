  <Item name="电弧炮装弹器" identifier="arccannonloader" tags="arccannonequipment,arccannonammosource,turretammosource" category="Machine,Weapon" subcategory="subweapons" linkable="true" allowedlinks="arccannon" scale="0.5" damagedbyexplosions="true" explosiondamagemultiplier="0.2">
