    <LightComponent range="150.0" lightcolor="120,170,255,255" pulsefrequency="12" pulseamount="0.8" powerconsumption="0" IsOn="false" castshadows="true" allowingameediting="false" characterusable="false">
      <sprite texture="%ModDir%/img/turrets_loader_glow.png" sourcerect="0,0,164,360" depth="0.1" origin="0.5,0.5" alpha="1.0" />
      <StatusEffect type="OnActive" target="This" stackable="false" delay="0.25" IsOn="false" />
    </LightComponent>
    <!-- 开火闪光·红 = 装着过载弹时的红色警示，开火时再叠一次点亮。 -->
