      <sprite texture="%ModDir%/img/turrets_loader_glow_red.png" sourcerect="0,0,164,360" depth="0.1" origin="0.5,0.5" alpha="1.0" />
      <IsActiveConditional targetcontaineditem="true" HasTag="arccannonammo3" conditionpercentage="gt 0" />
      <StatusEffect type="OnActive" target="This" stackable="false" delay="0.25" IsOn="false" />
    </LightComponent>
    <!-- 弹药量指示灯：直接照搬原版 pulselaserloader 的 6 颗 LED（第 104~127 行），
