  <!-- ============================ 弹丸 ============================ -->
  <!-- 隐藏物品：只在弹箱内部存在，由弹箱每次开火时生成，被炮塔取走 -->
  <Item name="电弧放电单元" identifier="arccannonbolt" category="Weapon" scale="0.5" sonarsize="2" hideinmenus="true">
    <Sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="0,0,1,1" depth="0.55" color="0,0,0,0" />
    <Body width="170" height="10" density="20" />
    <Holdable slots="RightHand+LeftHand" holdpos="0,-50" handle1="-10,0" handle2="10,0" aimable="false" />
    <Projectile characterusable="false" hitscan="true" removeonhit="true" damagedoors="true" penetration="0.6" maxtargetstohit="1">
      <!-- 沿射线铺开的电弧（已缩小：原来太粗太大） -->
      <ParticleEmitter particle="arccannon_arc" particleamount="1" emitacrossrayinterval="55" scalemin="0.5" scalemax="0.8" />
      <!-- 直击伤害：200 烧伤 + 175 深层组织伤 + 100 电击 + 10 秒眩晕 + 80 减速；不带 EMP（EMP 只在打中船壳后的放电里生效）。
           targetforce 300 = 击退、slow 80 = 减速拉满：这两条是给 StunImmunity="True" 的 21 个角色
           （末影虫、卡律布狄斯、锤头鲨全家、莫洛克、潜伏者、巨棘刺虫、机器人等）的保底控制，
           因为眩晕免疫是布尔硬开关，XML 无法绕过。 -->
      <Attack structuredamage="0" itemdamage="0" severlimbsprobability="0.1" penetration="0.6" targetforce="300">
        <Affliction identifier="burn" strength="200" dividebylimbcount="false" />
        <Affliction identifier="internaldamage" strength="175" dividebylimbcount="false" />
        <!-- 电击伤：和放电线圈同类型，会掉血 + 麻痹 -->
        <Affliction identifier="electricshock" strength="100" />
        <!-- 眩晕：每秒 -1 点，10 点 = 约 10 秒无法行动（原版上限 30）；对 StunImmunity 的角色无效 -->
        <Affliction identifier="stun" strength="10" />
        <!-- 减速：打到满值 80（上限 80），免疫眩晕的 Boss 也能被压到最低移速 —— 硬控失效时的保底手段 -->
        <Affliction identifier="slow" strength="80" />
      </Attack>
      <StatusEffect type="OnImpact" target="UseTarget">
        <ParticleEmitter particle="arccannon_impact" particleamount="4" anglemin="0" anglemax="360" velocitymin="0" velocitymax="120" scalemin="0.6" scalemax="1.1" />
        <ParticleEmitter particle="spark" copyentityangle="true" anglemin="-10" anglemax="10" particleamount="6" velocitymin="-10" velocitymax="-200" scalemin="0.4" scalemax="0.8" />
        <ParticleEmitter particle="weldspark" copyentityangle="true" anglemin="-40" anglemax="40" particleamount="6" velocitymin="-300" velocitymax="-800" scalemin="0.8" scalemax="1.4" colormultiplier="190,225,255,200" />
        <ParticleEmitter particle="FlareBubbles" particleamount="3" anglemin="0" anglemax="360" velocitymin="0" velocitymax="60" colormultiplier="170,215,255,200" />
        <sound file="Content/Items/Weapons/WEAPONS_electricalDischarge2.ogg" range="5000" />
      </StatusEffect>
      <!-- 命中生物：附带一次爆散（范围 175，烧伤 50 / 深层组织伤 35），只对角色生效。
           之前把 smoke/flames 都关了，结果只有伤害没有画面，看着像"没生效" —— 现在开烟、火花、焦痕、轻微镜头抖动。 -->
      <StatusEffect type="OnImpact" target="UseTarget">
        <Conditional entitytype="eq Character" />
        <Explosion range="175.0" structuredamage="0" itemdamage="0" ballastfloradamage="0" force="2.0" penetration="0.3" flames="false" smoke="true" sparks="true" underwaterbubble="true" applyfireeffects="false" decal="explosion" decalsize="0.2" camerashake="3.0" flash="true" flashcolor="200,230,255,255" flashrange="900" flashduration="0.08">
          <Affliction identifier="burn" strength="50" dividebylimbcount="false" />
          <Affliction identifier="internaldamage" strength="35" dividebylimbcount="false" />
          <Affliction identifier="electricshock" strength="35" />
          <Affliction identifier="stun" strength="1" />
        </Explosion>
      </StatusEffect>
      <!-- 命中船壳：放电线圈式的一层结算 —— 半径 750、ignorecover 无视掩体（内外墙通吃）。
           实际数值：电击 30 / 烧伤 15 / 深层组织伤 10 / 无眩晕，外加独立的 EMP 段（emp 100）。
           注意：这里拆成两段，每段只挂一个 Conditional —— 之前用 comparison="Or" 把 Structure 和 door 写在一起，
           实测不触发（引擎大概率按 And 处理，要求同时是墙又是门）。 -->
      <StatusEffect type="OnImpact" target="UseTarget">
        <Conditional entitytype="eq Structure" />
        <!-- 声光：照抄放电线圈 -->
        <sound file="Content/Items/Weapons/WEAPONS_electricalDischarge1.ogg" range="20000" selectionmode="Random" />
        <sound file="Content/Items/Weapons/WEAPONS_electricalDischarge2.ogg" range="20000" />
        <ParticleEmitter particle="risingbubbles" anglemin="0" anglemax="360" particleamount="24" velocitymin="30" velocitymax="70" scalemin="1" scalemax="1.6" />
        <!-- 沿着船壳乱窜的电弧：扩散速度收敛到约 335 像素范围 -->
        <ParticleEmitter particle="ElectricShock" particleamount="12" anglemin="0" anglemax="360" scalemin="2.5" scalemax="5" velocitymin="0" velocitymax="110" />
        <ParticleEmitter particle="arccannon_arc" particleamount="18" anglemin="0" anglemax="360" scalemin="1" scalemax="2" velocitymin="80" velocitymax="335" />
        <ParticleEmitter particle="spark" anglemin="0" anglemax="360" particleamount="14" velocitymin="60" velocitymax="240" scalemin="0.5" scalemax="1" colormultiplier="190,225,255,220" />
        <!-- 残留 0.35 秒的电弧场（纯视觉，不带伤害） -->
        <SpawnItem identifier="arccannon_dischargefield" spawnposition="This" />
        <!-- 1) 电人：电击麻痹 + 烧伤 + 深层组织伤 -->
        <Explosion range="750.0" structuredamage="0" itemdamage="0" ballastfloradamage="0" force="0.0" stun="0" penetration="0.3" camerashake="5" shockwave="false" flames="false" smoke="false" sparks="true" underwaterbubble="false" applyfireeffects="false" ignorecover="true" flash="true" flashcolor="150,205,255,255" flashrange="3000" flashduration="0.2">
          <Affliction identifier="electricshock" strength="30" />
          <Affliction identifier="burn" strength="15" dividebylimbcount="false" />
          <Affliction identifier="internaldamage" strength="10" dividebylimbcount="false" />
        </Explosion>
        <!-- 2) 电电器：电磁脉冲，和原版核弹 EMP 段同一写法 -->
        <Explosion range="750.0" force="0.0" smoke="false" sparks="false" empstrength="2.5" applyfireeffects="false" ignorecover="true">
          <Affliction identifier="emp" strength="100" multiplybymaxvitality="true" />
        </Explosion>
      </StatusEffect>
      <!-- 命中舱门：同样的放电（门是 Item，不是 Structure，所以要单独一段）。
           粒子参数与上面的船壳段保持一致（335 速度上限），否则打门和打墙的观感会不一样。 -->
      <StatusEffect type="OnImpact" target="UseTarget">
        <Conditional hastag="eq door" />
        <sound file="Content/Items/Weapons/WEAPONS_electricalDischarge1.ogg" range="20000" selectionmode="Random" />
        <ParticleEmitter particle="ElectricShock" particleamount="12" anglemin="0" anglemax="360" scalemin="2.5" scalemax="5" velocitymin="0" velocitymax="110" />
        <ParticleEmitter particle="arccannon_arc" particleamount="18" anglemin="0" anglemax="360" scalemin="1" scalemax="2" velocitymin="80" velocitymax="335" />
        <SpawnItem identifier="arccannon_dischargefield" spawnposition="This" />
        <Explosion range="750.0" structuredamage="0" itemdamage="0" ballastfloradamage="0" force="0.0" stun="0" penetration="0.3" camerashake="5" shockwave="false" flames="false" smoke="false" sparks="true" underwaterbubble="false" applyfireeffects="false" ignorecover="true" flash="true" flashcolor="150,205,255,255" flashrange="3000" flashduration="0.2">
          <Affliction identifier="electricshock" strength="30" />
          <Affliction identifier="burn" strength="15" dividebylimbcount="false" />
          <Affliction identifier="internaldamage" strength="10" dividebylimbcount="false" />
        </Explosion>
        <Explosion range="750.0" force="0.0" smoke="false" sparks="false" empstrength="2.5" applyfireeffects="false" ignorecover="true">
          <Affliction identifier="emp" strength="100" multiplybymaxvitality="true" />
        </Explosion>
      </StatusEffect>
      <!-- 弹药不允许在弹箱外长期存在（延迟 1 秒，照原版弹药的写法） -->
      <StatusEffect type="OnNotContained" target="This" delay="1">
        <Remove />
      </StatusEffect>
    </Projectile>
  </Item>
  <!-- ============================ 弹药箱 ============================ -->
