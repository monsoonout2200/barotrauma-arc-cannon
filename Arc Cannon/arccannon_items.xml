      <!-- 每次被触发：先补一发弹丸进箱内，再扣耐久；-10 一发，满耐久 100 = 10 发 -->
      <StatusEffect type="OnUse" target="This" disabledeltatime="true">
        <SpawnItem identifiers="arccannonbolt" spawnposition="ThisInventory" />
