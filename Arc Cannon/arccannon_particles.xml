  <!-- ===== 粒子光矛（群星风格）=====
       放弃"横向长条贴图 + 旋转对齐"的做法（那样每段的朝向/偏移很难和射线对上，
       实测会偏到炮口后面）。改用**圆形径向光球** lance_core.png：
       白热核心 + 向外渐隐的红晕，旋转对它没有意义，所以沿射线密集叠加就是一整条稳定的光束。 -->
  <arccannon_lance_red
    lifetime="0.16"
    lifetimemin="0"
    startdelaymin="0"
    startdelaymax="0"
    angularvelocitymin="0"
    angularvelocitymax="0"
    startrotationmin="0"
    startrotationmax="359"
    rotatetodirection="False"
    drag="0"
    waterdrag="0"
    velocitychange="0,0"
    velocitychangewater="0,0"
    collisionradius="1"
    usecollision="False"
    deleteoncollision="False"
    friction="0.5"
    restitution="0.5"
    startsizemin="0.30,0.30"
    startsizemax="0.42,0.42"
    growtime="0"
    sizechangemin="0,0"
    sizechangemax="0,0"
    startcolor="255,255,255,255"
    middlecolor="255,190,175,255"
    endcolor="255,90,70,0"
    usemiddlecolor="True"
    drawtarget="Both"
    drawontop="True"
    blendstate="Additive"
    loopanim="False"
    animduration="1"
    priority="20">
    <sprite texture="%ModDir%/img/lance_core.png" sourcerect="0,0,128,128" />
  </arccannon_lance_red>

  <!-- ===== 紫色脉冲：紫弹的"发射脉冲" =====
       用于紫弹（电弧帷幕）的弹道表现：从炮口沿瞄准方向窜出去的一发紫光。
       做法：单独的粒子，靠 velocity + copyentityangle 沿炮管方向飞出，
       短寿命（0.12~0.22 秒）后淡出。
       注意：hit-scan 是瞬时命中，引擎没有"沿射线移动的脉冲"这种机制，
       所以它只能飞出去一段距离就消失，不可能一路走到目标点。 -->
  <arccannon_pulse_purple
    lifetime="0.22"
    lifetimemin="0.12"
    startdelaymin="0"
    startdelaymax="0"
    angularvelocitymin="0"
    angularvelocitymax="0"
    startrotationmin="0"
    startrotationmax="0"
    rotatetodirection="False"
    drag="0"
    waterdrag="0"
    velocitychange="0,0"
    velocitychangewater="0,0"
    collisionradius="1"
    usecollision="False"
    deleteoncollision="False"
    friction="0"
    restitution="0"
    startsizemin="0.6,0.6"
    startsizemax="1.0,1.0"
    growtime="0.05"
    sizechangemin="-0.3,-0.3"
    sizechangemax="-0.5,-0.5"
    startcolor="255,250,255,255"
    middlecolor="200,140,255,220"
    endcolor="120,60,220,0"
    usemiddlecolor="True"
    drawtarget="Both"
    drawontop="False"
    blendstate="Additive"
    loopanim="False"
    animduration="1"
    priority="16">
    <sprite texture="%ModDir%/img/mist_purple.png" sourcerect="0,0,128,128" />
  </arccannon_pulse_purple>

  <!-- ===== 紫色电弧碎片：组成"电弧雾"的基本单位 =====
       仿原版 ElectricShock（0.25 秒 / 尺寸 2~4 / 四帧轮播），但更小更暗、偏紫，
       这样才能高频率大量堆叠而不过曝。
       用途：电弧帷幕（arccannon_arcmist）持续的放电区域，
       靠"大量小电弧不停换位置"形成闪成一片的雾，而不是一颗颗光团。 -->
  <arccannon_arcfog
    lifetime="0.22"
    lifetimemin="0.10"
    startdelaymin="0"
    startdelaymax="0.05"
    angularvelocitymin="-15"
    angularvelocitymax="15"
    startrotationmin="0"
    startrotationmax="359"
    rotatetodirection="False"
    drag="0"
    waterdrag="0"
    velocitychange="0,0"
    velocitychangewater="0,0"
    collisionradius="1"
    usecollision="False"
    deleteoncollision="False"
    friction="0.5"
    restitution="0.5"
    startsizemin="0.8,0.8"
    startsizemax="2.0,2.0"
    growtime="0"
    sizechangemin="0,0"
    sizechangemax="0,0"
    startcolor="240,220,255,235"
    middlecolor="190,130,255,200"
    endcolor="110,50,210,0"
    usemiddlecolor="True"
    drawtarget="Both"
    drawontop="True"
    blendstate="Additive"
    loopanim="False"
    animduration="1"
    priority="18">
    <sprite texture="Content/Particles/LightningParticleSheet.png" sourcerect="0,0,256,256" />
    <sprite texture="Content/Particles/LightningParticleSheet.png" sourcerect="256,0,256,256" />
    <sprite texture="Content/Particles/LightningParticleSheet.png" sourcerect="0,256,256,256" />
    <sprite texture="Content/Particles/LightningParticleSheet.png" sourcerect="256,256,256,256" />
  </arccannon_arcfog>

  <!-- ===== 紫色电雾：柔和径向光点，慢慢漂浮、逐渐淡出 =====
       用于第三种弹药「电弧帷幕」的持续区域，靠粒子密度营造"整片区域被充能"的体积感。
       rotation 无意义（圆对称贴图），所以随便转。 -->
  <arccannon_mist_purple
    lifetime="1.4"
    lifetimemin="0.8"
    startdelaymin="0"
    startdelaymax="0.15"
    angularvelocitymin="-30"
    angularvelocitymax="30"
