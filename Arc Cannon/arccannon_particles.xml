    deleteoncollision="False"
    friction="0.5"
    restitution="0.5"
    startsizemin="0.8,0.8"
    startsizemax="2.2,2.2"
    growtime="0.3"
    sizechangemin="0.4,0.4"
    sizechangemax="1.2,1.2"
    startcolor="255,245,255,220"
    middlecolor="200,140,255,170"
    endcolor="120,60,220,0"
    usemiddlecolor="True"
    drawtarget="Both"
